; Godot 4.7 editörüyle açılabilir. PSP'de EBOOT render yöntemini komut satırından "dummy" (PSP GE) olarak seçer;
; editör önizlemesi Compatibility renderer ile çalışır.

config_version=5

[application]

config/name="PSP Demo 3D"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")
boot_splash/show_image=false

[psp]

show_stats=true

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=false
